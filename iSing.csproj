<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType><RootNamespace>iSing</RootNamespace>
    <UseMaui>true</UseMaui><SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <ApplicationTitle>iSing</ApplicationTitle><ApplicationId>com.companyname.ising</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion><ApplicationVersion>5</ApplicationVersion>
    <EmbedAssembliesIntoApk Condition="'$(Configuration)' == 'Release'">true</EmbedAssembliesIntoApk>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">21.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <MauiIcon Include="Resources/AppIcon/appicon.png" Color="#195B87" BaseSize="50,50" />
    <MauiSplashScreen Include="Resources/Splash/splash.png" ForegroundFile="Resources/Splash/splash.png" Color="#195B87" BaseSize="120,120" />
    <MauiImage Include="Resources/Images/*" /><MauiFont Include="Resources/Fonts/*" />
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>
</Project>
