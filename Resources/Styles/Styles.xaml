<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Grundfarben je nach Systemdesign -->
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextColorLight}, Dark={StaticResource TextColorDark}}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Brand}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextColorLight}, Dark={StaticResource TextColorDark}}" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextColorLight}, Dark={StaticResource TextColorDark}}" />
        <Setter Property="TitleColor"
                Value="{AppThemeBinding Light={StaticResource TextColorLight}, Dark={StaticResource TextColorDark}}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Brand}" />
    </Style>

    <!-- Schriftgrade -->
    <Style x:Key="HeroTitleLabel" TargetType="Label">        
        <Setter Property="FontFamily" Value="BunnyCute" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="HeroTextLabel" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="HeroCaptionLabel" TargetType="Label" BasedOn="{StaticResource HeroTextLabel}">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="SongTitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="23" />
    </Style>

    <Style x:Key="HeadlineLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="22" />
    </Style>

    <Style x:Key="ErrorHeadlineLabel" TargetType="Label" BasedOn="{StaticResource HeadlineLabel}">
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="CardTitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="ListTitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="18" />
    </Style>

    <Style x:Key="VerseHeadingLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="VerseTextLabel" TargetType="Label">
        <Setter Property="LineHeight" Value="1.45" />
    </Style>

    <Style x:Key="CaptionLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="SmallLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="BadgeLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="GlyphLabel" TargetType="Label">
        <Setter Property="FontSize" Value="27" />
    </Style>

    <Style x:Key="ChevronLabel" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
    </Style>

    <!-- Flächen -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Padding" Value="18" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" />
    </Style>

    <!-- Kleines X rechts oben in Listeneinträgen -->
    <Style x:Key="RemoveItemButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextColorLight}, Dark={StaticResource TextColorDark}}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="MinimumWidthRequest" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="Margin" Value="0,-8,-8,0" />
    </Style>

    <Style x:Key="ListCardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>

    <Style x:Key="FilterChipBorder" TargetType="Border">
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Stroke" Value="{StaticResource Brand}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}" />
    </Style>

    <Style x:Key="ChipLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="BadgeBorder" TargetType="Border">
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 7" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource BadgeBackgroundLight}, Dark={StaticResource BadgeBackgroundDark}}" />
    </Style>

    <Style x:Key="AppPage" TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}" />
    </Style>

</ResourceDictionary>
